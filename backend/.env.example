# ─── Django ───────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=coworkhub.settings.development

# ─── Database (Production — TiDB Cloud) ───────────────────
# Leave blank for dev (SQLite is used automatically)
DB_NAME=coworkhub
DB_USER=your_tidb_user
DB_PASSWORD=your_tidb_password
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
TIDB_SSL_CA=/path/to/isrgrootx1.pem

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── CORS ─────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Email (Brevo) ────────────────────────────────────────
BREVO_EMAIL_USER=your-login-email@example.com
BREVO_API_KEY=your-brevo-smtp-api-key
DEFAULT_FROM_EMAIL=noreply@coworkhub.com

# ─── AI — Google Gemini (free tier) ──────────────────────
# Get free API key: https://aistudio.google.com/app/apikey
# Free limits: 15 req/min, 1M tokens/min, 1500 req/day
GEMINI_API_KEY=your-gemini-api-key-here

# ─── File Storage — S3 / MinIO (optional, production only) ───────────────
# Set USE_S3=True to enable. Requires: pip install django-storages boto3
# MinIO: set S3_ENDPOINT_URL to your MinIO server URL
# AWS S3: leave S3_ENDPOINT_URL blank
USE_S3=False
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=coworkhub-documents
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=ap-south-1

# ─── Production only ──────────────────────────────────────
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
